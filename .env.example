# --- SMS (optional) ---
# /api/text picks a backend by which of these is set (in this order):
#
#   1. Textbelt  (RECOMMENDED — cheap, pay-as-you-go, no phone number to buy):
#      Buy a key at https://textbelt.com/purchase/ (a few dollars for a block of
#      texts), then set it here. One line, works instantly on your own phone.
TEXTBELT_KEY=
#
#   2. Twilio (full control, needs a number + verified caller on trial):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
#
#   3. Neither set: demo mode — /api/text shows the message, sends nothing.

# --- Voice stock-check (optional) ---
# Without these, /api/stock runs in demo mode (simulates "in stock" after ~4s).
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Optional: a prebuilt Vapi assistant id. If set, it overrides the inline prompt.
VAPI_ASSISTANT_ID=
# The callback number the agent reads aloud if the pharmacy asks.
RXREACH_CALLBACK=+1XXXXXXXXXX
# Public https base (e.g. your ngrok URL) so Vapi can reach the webhook + SMS.
PUBLIC_BASE_URL=https://your-ngrok-id.ngrok.io
